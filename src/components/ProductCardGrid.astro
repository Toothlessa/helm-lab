---
import { site } from '../data/site';
import type { Product } from '../data/site';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const orderMsg = `Hi NOIR, I'd like to order: ${product.name} (${product.weight}) — $${product.price}`;
---

<article data-cat={product.category} class="group relative overflow-hidden rounded-lg border border-border bg-card transition-all duration-300 hover:border-primary/40">
  <a href={`/products/${product.slug}`} class="block">
    <div class="relative aspect-[3/4] overflow-hidden">
      <img
        src={product.image}
        alt={product.name}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-card via-card/20 to-transparent opacity-80"></div>
      {
        product.badge && (
          <span class="absolute left-3 top-3 rounded-sm bg-primary px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-primary-foreground">
            {product.badge}
          </span>
        )
      }
    </div>

    <div class="absolute bottom-0 left-0 right-0 p-5">
      <p class="text-xs uppercase tracking-[0.15em] text-muted-foreground/70">
        {product.roastLevel}
      </p>
      <h3 class="mt-1 font-display text-lg font-bold tracking-tight text-foreground">
        {product.name}
      </h3>
      <p class="mt-0.5 text-sm text-muted-foreground">{product.subtitle}</p>

      <div class="mt-3 flex items-center justify-between">
        <span class="font-display text-lg font-bold text-primary">${product.price}</span>
        <span class="text-xs text-muted-foreground">{product.weight}</span>
      </div>

      <div class="mt-3 flex flex-wrap gap-1">
        {
          product.notes.slice(0, 2).map((note) => (
            <span class="rounded-sm border border-border/50 px-2 py-0.5 text-xs text-muted-foreground">
              {note}
            </span>
          ))
        }
      </div>
    </div>
  </a>

  <div class="relative p-4 pt-0">
    <a
      href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(orderMsg)}`}
      target="_blank"
      rel="noopener"
      class="block w-full rounded-sm bg-primary py-2.5 text-center text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/85"
      data-wa
    >
      Order via WhatsApp
    </a>
  </div>
</article>
