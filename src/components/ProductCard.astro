---
import type { Product } from '../data/site';
import { waLink } from '../data/site';

interface Props {
  product: Product;
  featured?: boolean;
}

const { product, featured = false } = Astro.props;

const orderMsg = `Hi NOIR, I'd like to order: ${product.name} (${product.weight}) — $${product.price}`;
---

<article
  class:list={[
    'group relative overflow-hidden rounded-lg border border-border bg-card transition-all duration-300 hover:border-primary/40',
    featured ? 'md:flex md:items-stretch' : '',
  ]}
>
  <div
    class:list={[
      'relative overflow-hidden',
      featured ? 'md:w-1/2' : '',
    ]}
  >
    <div class={featured ? 'aspect-[4/3] md:aspect-auto md:h-full' : 'aspect-[4/5]'}>
      <img
        src={product.image}
        alt={product.name}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
    </div>
    {
      product.badge && (
        <span class="absolute left-3 top-3 rounded-sm bg-primary px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-primary-foreground">
          {product.badge}
        </span>
      )
    }
  </div>

  <div
    class:list={[
      'flex flex-col p-5',
      featured ? 'md:w-1/2 md:justify-center md:p-10' : '',
    ]}
  >
    <p class="text-xs uppercase tracking-[0.15em] text-muted-foreground/70">
      {product.roastLevel} · {product.origin}
    </p>
    <h3
      class:list={[
        'mt-2 font-display font-bold tracking-tight',
        featured ? 'text-2xl md:text-3xl' : 'text-lg',
      ]}
    >
      {product.name}
    </h3>
    <p class="mt-1 text-sm italic text-muted-foreground">{product.subtitle}</p>

    {
      featured && (
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
          {product.description}
        </p>
      )
    }

    <div class="mt-4 flex flex-wrap gap-1.5">
      {
        product.notes.map((note) => (
          <span class="rounded-sm border border-border/60 px-2 py-0.5 text-xs text-muted-foreground">
            {note}
          </span>
        ))
      }
    </div>

    <div class="mt-5 flex items-center justify-between">
      <div class="flex items-baseline gap-1">
        <span class="font-display text-xl font-bold text-primary">${product.price}</span>
        <span class="text-xs text-muted-foreground">/ {product.weight}</span>
      </div>
    </div>

    <div class="mt-4 flex gap-2">
      <a
        href={`/products/${product.slug}`}
        class="flex-1 rounded-sm border border-border px-4 py-2.5 text-center text-sm font-medium text-foreground transition-colors hover:border-foreground/30 hover:bg-secondary"
      >
        Details
      </a>
      <a
        href={waLink(orderMsg)}
        target="_blank"
        rel="noopener"
        class="flex-1 rounded-sm bg-primary px-4 py-2.5 text-center text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/85"
      >
        Order
      </a>
    </div>
  </div>
</article>
