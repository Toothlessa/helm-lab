---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
}

const { eyebrow, title, subtitle, centered = false } = Astro.props;
---

<div class:list={[centered ? 'text-center' : '', 'max-w-2xl', centered ? 'mx-auto' : '']}>
  {
    eyebrow && (
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">
        {eyebrow}
      </p>
    )
  }
  <h2 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight md:text-4xl lg:text-5xl">
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-4 text-base leading-relaxed text-muted-foreground md:text-lg">
        {subtitle}
      </p>
    )
  }
</div>
