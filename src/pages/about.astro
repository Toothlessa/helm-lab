---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site, waLink } from '../data/site';
---

<Layout title="Our Story — NOIR" description="The story behind NOIR Coffee.">

  <!-- Hero -->
  <section class="relative min-h-[60vh] overflow-hidden border-b border-border/40">
    <div class="absolute inset-0">
      <img
        src="https://images.pexels.com/photos/20276603/pexels-photo-20276603.jpeg?auto=compress&cs=tinysrgb&h=900&w=1600"
        alt="Foggy field at sunrise"
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-background/60 via-background/50 to-background"></div>
    </div>
    <div class="container-site relative flex min-h-[60vh] flex-col justify-center pt-20">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-primary">Our Story</p>
      <h1 class="mt-4 font-display text-5xl font-extrabold leading-[0.95] tracking-tight md:text-7xl">
        Roasted in<br />the Dark
      </h1>
    </div>
  </section>

  <!-- Story sections -->
  <section class="py-20 md:py-32">
    <div class="container-site max-w-3xl">
      <div class="space-y-12">
        <div>
          <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">The Beginning</h2>
          <p class="mt-4 text-base leading-relaxed text-muted-foreground">
            NOIR started in a garage with a 5kg drum roaster and a stubborn belief that coffee should taste like something. Not mild. Not inoffensive. Something. We roasted past the second crack because that's where the character lives — in the dark, where the sugars caramelize and the oils rise to the surface.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">The Method</h2>
          <p class="mt-4 text-base leading-relaxed text-muted-foreground">
            Every batch is roasted in quantities no larger than 5kg. We monitor temperature curves by hand, listen for the cracks, and cool the beans the moment they hit their peak. No automation. No shortcuts. Just a person, a drum, and the beans. This is slow coffee — not because it's trendy, but because it's better.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">The Sourcing</h2>
          <p class="mt-4 text-base leading-relaxed text-muted-foreground">
            We buy directly from high-altitude farms across the equatorial belt — Sumatra, Colombia, Ethiopia, Guatemala, Honduras. We pay above fair trade prices because the farmers who grow exceptional beans deserve to keep doing it. Every bag we sell is traceable to its origin.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">The Promise</h2>
          <p class="mt-4 text-base leading-relaxed text-muted-foreground">
            Roasted within 48 hours of your order. Shipped in sealed bags with one-way valves to preserve freshness. If it's not the best coffee you've had this month, tell us — we'll make it right. That's not a marketing line. That's a WhatsApp message away.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Image break -->
  <section class="relative h-[50vh] overflow-hidden border-y border-border/40">
    <img
      src="https://images.pexels.com/photos/31986308/pexels-photo-31986308.jpeg?auto=compress&cs=tinysrgb&h=900&w=1600"
      alt="Plantation hills at sunrise"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-background/30"></div>
  </section>

  <!-- Values grid -->
  <section class="py-20 md:py-32">
    <div class="container-site">
      <SectionHeading
        eyebrow="What We Stand For"
        title="Our Principles"
        centered={true}
      />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          [
            {
              title: 'Small Batch',
              text: 'Never more than 5kg at a time. Every batch gets individual attention from roast to cool.',
            },
            {
              title: 'Ethically Sourced',
              text: 'Direct trade relationships. Above fair-trade prices. Full traceability on every bag.',
            },
            {
              title: 'Roasted to Order',
              text: 'Your coffee is roasted after you order it, not before. Shipped within 48 hours.',
            },
            {
              title: 'No Blends Disguised',
              text: 'If we say single-origin, it is. Our blends are labeled as blends. Honest labeling.',
            },
            {
              title: 'Dark by Default',
              text: 'We roast dark because that is our craft. But our light roasts are equally considered.',
            },
            {
              title: 'WhatsApp First',
              text: 'No checkout forms. No accounts. Message us, tell us what you want, we ship it.',
            },
          ].map((item) => (
            <div class="rounded-lg border border-border bg-card p-6">
              <h3 class="font-display text-lg font-bold tracking-tight">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-border/40 bg-card/30 py-20 md:py-28">
    <div class="container-site text-center">
      <h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">
        Taste the Difference
      </h2>
      <p class="mx-auto mt-4 max-w-md text-base text-muted-foreground">
        Browse the collection or message us directly. We will help you find your shade.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={waLink()}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-sm bg-[#25D366] px-8 py-3.5 text-sm font-semibold text-white transition-all hover:scale-[1.02] hover:bg-[#1faa4f]"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Message Us
        </a>
        <a
          href="/products"
          class="inline-flex items-center justify-center rounded-sm border border-border px-8 py-3.5 text-sm font-semibold text-foreground transition-colors hover:border-foreground/30 hover:bg-secondary"
        >
          Browse Products
        </a>
      </div>
    </div>
  </section>

</Layout>
