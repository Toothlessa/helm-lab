---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import ProductCardGrid from "../components/ProductCardGrid.astro";
import CategoryCard from "../components/CategoryCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { products, categories, site, waLink } from "../data/site";

const newCollection = products.slice(0, 4);
const allProducts = products;
---

<Layout title="NOIR — Crafted in Shadow | Premium Coffee">
    <!-- ===== HERO ===== -->
    <section class="relative min-h-[100vh] overflow-hidden">
        <div class="absolute inset-0">
            <img
                src="/images/jasa-cuci-helm.jpg"
                alt="Cleaned in Silence"
                class="h-full w-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-b from-background/80 via-background/40 to-background"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-background/70 to-transparent"></div>
        </div>

        <div class="container-site relative flex min-h-[100vh] flex-col justify-center pt-20">
            <div class="max-w-2xl">
                <p class="animate-fade-up text-xs font-semibold uppercase tracking-[0.25em] text-primary">
                    New · 2026 Service and Product
                </p>
                <h1
                    class="mt-4 animate-fade-up font-display text-5xl font-extrabold leading-[0.95] tracking-tight md:text-7xl lg:text-8xl"
                    style="animation-delay: 0.1s; opacity: 0;"
                >
                    Clean
                    <br />
                    Maximal
                </h1>
                <p
                    class="mt-6 max-w-lg animate-fade-up text-base leading-relaxed text-foreground/80 md:text-lg"
                    style="animation-delay: 0.2s; opacity: 0;"
                >
                    Premium helmet cleaning for daily commuters. Deep-cleaned
                    and fresh for those who ride the long road.
                </p>
                <div
                    class="mt-8 flex animate-fade-up flex-col gap-3 sm:flex-row"
                    style="animation-delay: 0.3s; opacity: 0;"
                >
                    <a
                        href="/products"
                        class="inline-flex items-center justify-center rounded-sm bg-primary px-8 py-3.5 text-sm font-semibold text-primary-foreground transition-all hover:bg-primary/85 hover:scale-[1.02]"
                    >
                        Service & Product
                    </a>
                    <a
                        href={waLink()}
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-center justify-center rounded-sm border border-foreground/20 px-8 py-3.5 text-sm font-semibold text-foreground transition-all hover:border-foreground/40 hover:bg-secondary"
                    >
                        Order via WhatsApp
                    </a>
                </div>
            </div>
        </div>

        <div class="absolute bottom-8 left-0 right-0">
            <div class="container-site flex items-center gap-6 text-xs uppercase tracking-[0.2em] text-muted-foreground/60">
                <span>Scroll</span>
                <div class="h-px flex-1 max-w-32 bg-foreground/15"></div>
                <span>Explore</span>
            </div>
        </div>
    </section>

    <!-- ===== MARQUEE BAR ===== -->
    <section class="border-y border-border/40 bg-card/20 py-4 overflow-hidden">
        <div class="flex animate-marquee whitespace-nowrap">
            {Array.from({ length: 2 }).map(() => (
                <div class="flex items-center gap-8 px-4">
                    {[
                        "Cuci bersih 100% anti-bakteri",
                        "Selesai cepat & bebas bau",
                        "Busa lembut · Visor jernih",
                        "Ramah untuk semua jenis helm",
                        "Order via WhatsApp",
                    ].map((item) => (
                        <span class="flex items-center gap-8 text-sm font-medium uppercase tracking-[0.15em] text-muted-foreground">
                            {item}
                            <span class="text-primary">●</span>
                        </span>
                    ))}
                </div>
            ))}
        </div>
    </section>

    <!-- ===== NEW COLLECTION (Featured products) ===== -->
    <section class="py-20 md:py-32">
        <div class="container-site">
            <SectionHeading
                eyebrow="Layanan Terbaru"
                title="Paket Perawatan"
                subtitle="Segar dari bengkel kami. Perawatan helm terbaik untuk kenyamanan berkendara, dengan karakter dan kualitas maksimal."
            />

            <div class="mt-12 grid gap-6 md:grid-cols-2">
                {newCollection.map((product, i) => (
                    <ProductCard product={product} featured={i < 2} />
                ))}
            </div>
        </div>
    </section>

    <!-- ===== CATEGORIES ===== -->
    <section
        class="border-y border-border/40 bg-card/20 py-20 md:py-32"
        id="categories"
    >
        <div class="container-site">
            <SectionHeading
                eyebrow="Browse by Type"
                title="Our Collections"
                subtitle="From bold dark roasts to bright light roasts — find your shade."
                centered={true}
            />

            <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {categories.map((cat, i) => (
                    <CategoryCard category={cat} index={i} />
                ))}
            </div>

            <div class="mt-10 text-center">
                <a
                    href="/products"
                    class="inline-flex items-center gap-2 rounded-sm border border-border px-6 py-3 text-sm font-semibold text-foreground transition-colors hover:border-foreground/30 hover:bg-secondary"
                >
                    View All Products
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- ===== ALL PRODUCTS ===== -->
    <section class="py-20 md:py-32">
        <div class="container-site">
            <SectionHeading
                eyebrow="All Products"
                title="The Full Lineup"
                subtitle="Every roast we offer. Pick your shade, order through WhatsApp."
            />

            <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                {allProducts.map((product) => (
                    <ProductCardGrid product={product} />
                ))}
            </div>
        </div>
    </section>

    <!-- ===== STORY / FEATURED BANNER ===== -->
    <section class="relative overflow-hidden border-y border-border/40">
        <div class="absolute inset-0">
            <img
                src="https://images.pexels.com/photos/2884456/pexels-photo-2884456.jpeg?auto=compress&cs=tinysrgb&h=900&w=1600"
                alt="Coffee plantation at dawn"
                class="h-full w-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-background via-background/80 to-background/30"></div>
        </div>

        <div class="container-site relative py-24 md:py-36">
            <div class="max-w-xl">
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-primary">
                    Our Story
                </p>
                <h2 class="mt-4 font-display text-3xl font-bold leading-tight tracking-tight md:text-5xl">
                    From Bean
                    <br />
                    to Shadow
                </h2>
                <p class="mt-6 text-base leading-relaxed text-foreground/80 md:text-lg">
                    We source single-origin beans from high-altitude farms
                    across the equatorial belt. Each batch is roasted in small
                    quantities — never more than 5kg at a time — to ensure every
                    cup carries the full weight of its origin.
                </p>
                <p class="mt-4 text-base leading-relaxed text-foreground/80 md:text-lg">
                    No shortcuts. No blends disguised as single-origin. Just
                    honest coffee, roasted dark, and shipped fresh.
                </p>
                <a
                    href="/about"
                    class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-primary transition-all hover:gap-4"
                >
                    Read Our Full Story
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- ===== NEWS / UPDATES ===== -->
    <section class="py-20 md:py-32">
        <div class="container-site">
            <SectionHeading
                eyebrow="News & Updates"
                title="From the Roastery"
                centered={true}
            />

            <div class="mt-12 grid gap-6 md:grid-cols-3">
                {[
                    {
                        tag: "Event",
                        date: "Oct 2026",
                        title: "NOIR Pop-Up Tasting at Downtown Market",
                        excerpt:
                            "Join us for a blind tasting of our new dark roast lineup. Free entry, free coffee, dark mood lighting.",
                        image: "https://images.pexels.com/photos/13365467/pexels-photo-13365467.jpeg?auto=compress&cs=tinysrgb&h=650&w=940",
                    },
                    {
                        tag: "New Release",
                        date: "Sep 2026",
                        title: "Ironwood — Single-Origin Guatemalan Dark Roast",
                        excerpt:
                            "Our newest single-origin from the Huehuetenango highlands. Heavy body, smoky, with a long finish.",
                        image: "https://images.pexels.com/photos/30444150/pexels-photo-30444150.jpeg?auto=compress&cs=tinysrgb&h=650&w=940",
                    },
                    {
                        tag: "Behind the Scenes",
                        date: "Aug 6, 2026",
                        title: "How We Roast: The NOIR Method",
                        excerpt:
                            "A look inside our roasting process — from green bean selection to the final crack and cool.",
                        image: "https://images.pexels.com/photos/4820838/pexels-photo-4820838.jpeg?auto=compress&cs=tinysrgb&h=650&w=940",
                    },
                ].map((item) => (
                    <article class="group overflow-hidden rounded-lg border border-border bg-card transition-all hover:border-primary/40">
                        <div class="aspect-[16/10] overflow-hidden">
                            <img
                                src={item.image}
                                alt={item.title}
                                loading="lazy"
                                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                            />
                        </div>
                        <div class="p-6">
                            <div class="flex items-center gap-3 text-xs text-muted-foreground/70">
                                <span class="rounded-sm bg-secondary px-2 py-0.5 font-medium text-foreground">
                                    {item.tag}
                                </span>
                                <span>{item.date}</span>
                            </div>
                            <h3 class="mt-3 font-display text-lg font-bold leading-snug tracking-tight">
                                {item.title}
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                                {item.excerpt}
                            </p>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <!-- ===== CTA BANNER ===== -->
    <section class="border-t border-border/40 bg-card/30 py-20 md:py-28">
        <div class="container-site text-center">
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
                Ready to Taste
                <br />
                the Dark Side?
            </h2>
            <p class="mx-auto mt-4 max-w-md text-base text-muted-foreground">
                Order directly through WhatsApp. Fast, personal, no checkout
                forms.
            </p>
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <a
                    href={waLink(
                        `Hi NOIR, I'd like to browse your coffee selection.`,
                    )}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 rounded-sm bg-[#25D366] px-8 py-3.5 text-sm font-semibold text-white transition-all hover:scale-[1.02] hover:bg-[#1faa4f]"
                >
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                    </svg>
                    Order on WhatsApp
                </a>
                <a
                    href="/products"
                    class="inline-flex items-center justify-center rounded-sm border border-border px-8 py-3.5 text-sm font-semibold text-foreground transition-colors hover:border-foreground/30 hover:bg-secondary"
                >
                    Browse Products
                </a>
            </div>
        </div>
    </section>
</Layout>
