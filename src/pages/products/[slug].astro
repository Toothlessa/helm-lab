---
import Layout from '../../layouts/Layout.astro';
import ProductCardGrid from '../../components/ProductCardGrid.astro';
import { products, site, waLink, categories } from '../../data/site';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = products.find((p) => p.slug === slug);

if (!product) {
  return Astro.redirect('/products');
}

const orderMsg = `Hi NOIR, I'd like to order: ${product.name} (${product.weight}) — $${product.price}`;
const bulkOrderMsg = `Hi NOIR, I'd like to order 3x ${product.name} (${product.weight}) with the 10% bulk discount — $${(product.price * 3 * 0.9).toFixed(2)}`;

const related = products
  .filter((p) => p.category === product.category && p.slug !== product.slug)
  .slice(0, 4);
const fallbackRelated = products.filter((p) => p.slug !== product.slug).slice(0, 4);
const displayRelated = related.length >= 2 ? related : fallbackRelated;

const cat = categories.find((c) => c.slug === product.category);
---

<Layout title={`${product.name} — NOIR`} description={product.description}>

  <!-- Breadcrumb -->
  <section class="pt-28 md:pt-32">
    <div class="container-site">
      <nav class="flex items-center gap-2 text-xs text-muted-foreground/70">
        <a href="/" class="transition-colors hover:text-primary">Home</a>
        <span>/</span>
        <a href="/products" class="transition-colors hover:text-primary">Shop</a>
        <span>/</span>
        <a href={`/products?cat=${product.category}`} class="transition-colors hover:text-primary">{cat?.name ?? product.category}</a>
        <span>/</span>
        <span class="text-foreground">{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product detail -->
  <section class="py-10 md:py-16">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <!-- Image -->
        <div class="relative">
          <div class="relative overflow-hidden rounded-lg border border-border">
            <div class="aspect-[4/5]">
              <img
                src={product.image}
                alt={product.name}
                class="h-full w-full object-cover"
              />
            </div>
            {
              product.badge && (
                <span class="absolute left-4 top-4 rounded-sm bg-primary px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary-foreground">
                  {product.badge}
                </span>
              )
            }
          </div>
        </div>

        <!-- Info -->
        <div class="flex flex-col">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">
            {product.roastLevel} · {product.origin}
          </p>
          <h1 class="mt-3 font-display text-4xl font-bold leading-tight tracking-tight md:text-5xl">
            {product.name}
          </h1>
          <p class="mt-2 text-lg italic text-muted-foreground">{product.subtitle}</p>

          <div class="mt-6 flex items-baseline gap-2">
            <span class="font-display text-3xl font-bold text-primary">${product.price}</span>
            <span class="text-sm text-muted-foreground">/ {product.weight}</span>
          </div>

          <p class="mt-6 text-base leading-relaxed text-foreground/80">
            {product.description}
          </p>

          <!-- Notes -->
          <div class="mt-8">
            <h3 class="text-xs font-semibold uppercase tracking-[0.15em] text-muted-foreground">Tasting Notes</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {
                product.notes.map((note) => (
                  <span class="rounded-sm border border-border bg-card px-3 py-1.5 text-sm text-foreground">
                    {note}
                  </span>
                ))
              }
            </div>
          </div>

          <!-- Specs -->
          <div class="mt-8 grid grid-cols-2 gap-4 border-t border-border/40 pt-6">
            <div>
              <p class="text-xs uppercase tracking-[0.15em] text-muted-foreground/70">Origin</p>
              <p class="mt-1 text-sm font-medium text-foreground">{product.origin}</p>
            </div>
            <div>
              <p class="text-xs uppercase tracking-[0.15em] text-muted-foreground/70">Roast Level</p>
              <p class="mt-1 text-sm font-medium text-foreground">{product.roastLevel}</p>
            </div>
            <div>
              <p class="text-xs uppercase tracking-[0.15em] text-muted-foreground/70">Weight</p>
              <p class="mt-1 text-sm font-medium text-foreground">{product.weight}</p>
            </div>
            <div>
              <p class="text-xs uppercase tracking-[0.15em] text-muted-foreground/70">Category</p>
              <p class="mt-1 text-sm font-medium text-foreground">{cat?.name ?? product.category}</p>
            </div>
          </div>

          <!-- CTAs -->
          <div class="mt-8 space-y-3">
            <a
              href={waLink(orderMsg)}
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center gap-2 rounded-sm bg-[#25D366] px-6 py-4 text-sm font-semibold text-white transition-all hover:scale-[1.01] hover:bg-[#1faa4f]"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Order via WhatsApp — ${product.price}
            </a>
            <a
              href={waLink(bulkOrderMsg)}
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center gap-2 rounded-sm border border-border px-6 py-3.5 text-sm font-semibold text-foreground transition-colors hover:border-foreground/30 hover:bg-secondary"
            >
              Order 3+ bags — 10% off
            </a>
          </div>

          <p class="mt-4 text-xs text-muted-foreground/60">
            Roasted to order within 48 hours. Free shipping on orders over $50.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related products -->
  <section class="border-t border-border/40 py-16 md:py-24">
    <div class="container-site">
      <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">
        More Like This
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {displayRelated.map((p) => <ProductCardGrid product={p} />)}
      </div>
    </div>
  </section>

</Layout>
